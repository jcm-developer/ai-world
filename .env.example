# ─────────────────────────────────────────────────────────────
#  AI World — configuración
#  Copia este archivo como .env y rellena tu clave.
#  El archivo .env NUNCA se sube a git ni llega al navegador.
# ─────────────────────────────────────────────────────────────

# --- Proveedor del modelo (cualquiera compatible con OpenAI) ---
# OpenAI (por defecto). Clave en https://platform.openai.com/api-keys (empieza por "sk-")
# Consejo: pon un límite de gasto en platform.openai.com → Settings → Limits.
API_KEY=
BASE_URL=https://api.openai.com/v1
MODEL=gpt-5.4-mini

# Otros proveedores: cambia BASE_URL y MODEL (y la clave si hace falta).
# Si API_KEY está vacía se usa NVIDIA_API_KEY.
#   NVIDIA NIM:                           BASE_URL=https://integrate.api.nvidia.com/v1  MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
#   Ollama en Docker (perfil local-llm):  BASE_URL=http://ollama:11434/v1               MODEL=qwen2.5:7b
#   Ollama en tu máquina:                 BASE_URL=http://localhost:11434/v1            MODEL=qwen2.5:7b
# NVIDIA_API_KEY=

# --- Bucle del agente ---
# Milisegundos mínimos entre decisiones (5000 ≈ 12 peticiones/min como máximo;
# mientras el avatar camina no se hacen peticiones)
TICK_MS=5000
# Cuántas notas recientes de memoria se envían al modelo en cada tick
MEMORY_WINDOW=12
# "required" obliga a usar una herramienta; si el proveedor no lo admite se pasa a "auto" solo
TOOL_CHOICE=required
# Si el modelo no admite temperature o max_tokens, el servidor se adapta solo
TEMPERATURE=0.6
# Razonamiento interno (gpt-5.x y similares): none | low | medium | high. Con low resuelve mucho mejor
# los acertijos del escape room y apenas es más lento. Si el proveedor no lo admite, se desactiva solo.
REASONING_EFFORT=low
# API: auto (recomendado) | chat | responses. En auto, con OpenAI y razonamiento se usa la API Responses,
# que es la que permite combinar herramientas y razonamiento en gpt-5.4-mini.
API_MODE=auto
MAX_TOKENS=1500
# Tiempo máximo de espera por respuesta del modelo
REQUEST_TIMEOUT_MS=90000

# --- Voz de los agentes ---
# openai = voz natural con la API de OpenAI · browser = voz del navegador (gratis) · off = sin voz
# Solo se genera audio mientras alguien tiene la voz activada en el navegador.
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
# Voz por defecto (cada escenario puede usar la suya): marin, cedar, coral, sage, alloy…
TTS_VOICE=marin
# Opcional: otra clave para la voz (si el modelo principal es de otro proveedor, p. ej. NVIDIA)
# TTS_API_KEY=

# true = cerebro simulado sin red (para probar sin clave ni gasto de peticiones)
MOCK_LLM=false

# --- Servidor ---
PORT=3000
# Base de datos SQLite (ruta relativa a /server). En Docker se usa un volumen en /data.
DB_PATH=./data/ai-world.db
